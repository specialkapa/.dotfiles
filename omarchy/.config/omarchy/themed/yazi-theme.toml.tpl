# Yazi theme generated by Omarchy from the current theme's colors.toml.
# ~/.config/yazi/theme.toml symlinks to the rendered copy, so it follows `omarchy theme set`.

[mgr]
cwd = { fg = "{{ accent }}", bold = true }

hovered         = { fg = "{{ background }}", bg = "{{ accent }}", bold = true }
preview_hovered = { underline = true }

find_keyword  = { fg = "{{ yellow }}", bold = true, italic = true, underline = true }
find_position = { fg = "{{ magenta }}", bg = "reset", bold = true, italic = true }

marker_copied   = { fg = "{{ green }}", bg = "{{ green }}" }
marker_cut      = { fg = "{{ red }}", bg = "{{ red }}" }
marker_marked   = { fg = "{{ cyan }}", bg = "{{ cyan }}" }
marker_selected = { fg = "{{ yellow }}", bg = "{{ yellow }}" }

count_copied   = { fg = "{{ background }}", bg = "{{ green }}" }
count_cut      = { fg = "{{ background }}", bg = "{{ red }}" }
count_selected = { fg = "{{ background }}", bg = "{{ yellow }}" }

border_symbol = "│"
border_style  = { fg = "{{ muted }}" }

[indicator]
# Plain-space padding gives the hovered row square ends instead of rounded caps.
parent  = { fg = "{{ background }}", bg = "{{ accent }}", bold = true }
current = { fg = "{{ background }}", bg = "{{ accent }}", bold = true }
preview = { fg = "{{ background }}", bg = "{{ accent }}", bold = true }
padding = { open = " ", close = " " }

[tabs]
active   = { fg = "{{ background }}", bg = "{{ accent }}", bold = true }
inactive = { fg = "{{ accent }}", bg = "{{ selection }}" }

[mode]
normal_main = { fg = "{{ background }}", bg = "{{ accent }}", bold = true }
normal_alt  = { fg = "{{ accent }}", bg = "{{ selection }}" }
select_main = { fg = "{{ background }}", bg = "{{ magenta }}", bold = true }
select_alt  = { fg = "{{ magenta }}", bg = "{{ selection }}" }
unset_main  = { fg = "{{ background }}", bg = "{{ red }}", bold = true }
unset_alt   = { fg = "{{ red }}", bg = "{{ selection }}" }

[status]
overall = { fg = "{{ foreground }}", bg = "reset" }
sep_left  = { open = "", close = "" }
sep_right = { open = "", close = "" }

perm_type  = { fg = "{{ green }}" }
perm_read  = { fg = "{{ yellow }}" }
perm_write = { fg = "{{ red }}" }
perm_exec  = { fg = "{{ cyan }}" }
perm_sep   = { fg = "{{ muted }}" }

progress_label  = { fg = "{{ bright_foreground }}", bold = true }
progress_normal = { fg = "{{ accent }}", bg = "{{ selection }}" }
progress_error  = { fg = "{{ red }}", bg = "{{ selection }}" }

[which]
mask            = { bg = "reset" }
cand            = { fg = "{{ cyan }}" }
rest            = { fg = "{{ dark_foreground }}" }
desc            = { fg = "{{ magenta }}" }
separator_style = { fg = "{{ muted }}" }

[confirm]
border  = { fg = "{{ accent }}" }
title   = { fg = "{{ accent }}" }
btn_yes = { fg = "{{ background }}", bg = "{{ accent }}" }

[spot]
border = { fg = "{{ accent }}" }
title  = { fg = "{{ accent }}" }

[notify]
title_info  = { fg = "{{ green }}" }
title_warn  = { fg = "{{ yellow }}" }
title_error = { fg = "{{ red }}" }

[pick]
border   = { fg = "{{ accent }}" }
active   = { fg = "{{ magenta }}", bold = true }
inactive = {}

[input]
border   = { fg = "{{ accent }}" }
title    = {}
value    = {}
selected = { reversed = true }

[cmp]
border = { fg = "{{ accent }}" }

[tasks]
border  = { fg = "{{ accent }}" }
title   = {}
hovered = { fg = "{{ magenta }}", underline = true }

[help]
on      = { fg = "{{ cyan }}" }
run     = { fg = "{{ magenta }}" }
hovered = { reversed = true, bold = true }
footer  = { fg = "{{ background }}", bg = "{{ foreground }}" }

[filetype]
rules = [
	# Images
	{ mime = "image/*", fg = "{{ yellow }}" },
	# Media
	{ mime = "{audio,video}/*", fg = "{{ magenta }}" },
	# Archives
	{ mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "{{ red }}" },
	# Documents
	{ mime = "application/{pdf,doc,rtf}", fg = "{{ cyan }}" },
	# Broken links
	{ url = "*", is = "orphan", fg = "{{ red }}" },
	# Executables
	{ url = "*", is = "exec", fg = "{{ green }}" },
	# Fallback
	{ url = "*", fg = "{{ foreground }}" },
	{ url = "*/", fg = "{{ blue }}" },
]

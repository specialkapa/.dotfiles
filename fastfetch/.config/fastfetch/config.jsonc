{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "iterm",
    "source": "~/.config/fastfetch/logo.png",
    "width": 18,
    "height": 9,
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "break"
    },
    {
      "type": "break"
    },
    {
      "type": "title",
      "key": "  user   ",
      "keyColor": "blue",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "uptime",
      "key": "  uptime ",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "  term   ",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "  shell  ",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "  cpu    ",
      "keyColor": "blue",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "  memory ",
      "keyColor": "magenta"
    },
    {
      "type": "swap",
      "key": "  swap   ",
      "keyColor": "red"
    },
    {
      "type": "localip",
      "key": "  network",
      "keyColor": "blue"
    }
  ]
}

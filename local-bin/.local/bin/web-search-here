#!/bin/bash
# Open a web search in the browser window on the current Hyprland workspace.
# If a browser window is on this workspace, focus it and open a new tab there;
# otherwise open a new browser window, which lands on the current workspace.
#
# Usage: web-search-here <query...>
# Engine: set WEB_SEARCH_URL (use %s for the query), default Google.

set -u
query="$*"
[[ -z ${query// /} ]] && exit 0

template=${WEB_SEARCH_URL:-https://www.google.com/search?q=%s}
encoded=$(jq -rn --arg q "$query" '$q | @uri')
url=${template//%s/$encoded}

# Resolve the default browser: desktop id -> window class and executable.
desktop=$(omarchy-cmd-default-browser 2>/dev/null || xdg-settings get default-web-browser)
class=${desktop%.desktop}
browser_exec=""
IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
for dir in "${data_dirs[@]}"; do
  entry="$dir/applications/$desktop"
  [[ -f $entry ]] || continue
  browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$entry" | head -1)
  break
done
# omarchy-browser.desktop wraps the real one; fall back to the class name.
[[ -z $browser_exec || $browser_exec == omarchy-launch-browser ]] && browser_exec=$class

workspace=$(hyprctl activeworkspace -j | jq -r '.id')

# Most recently focused normal browser window on this workspace (web apps have
# their own class, so they are excluded by the exact class match).
address=$(hyprctl clients -j | jq -r --arg c "$class" --argjson ws "$workspace" '
  [ .[] | select(.workspace.id == $ws and .class == $c) ]
  | sort_by(.focusHistoryID) | .[0].address // empty')

send() {
  # Hand off to the running browser when possible (fast), else start it.
  omarchy-cmd-browser-handoff "$browser_exec" "$@" 2>/dev/null ||
    setsid -f uwsm-app -- "$browser_exec" "$@" >/dev/null 2>&1
}

if [[ -n $address ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 ||
    hyprctl dispatch focuswindow "address:$address" >/dev/null
  sleep 0.15 # let the browser register the window as its last active one
  send "$url"
else
  send --new-window "$url"
fi

#!/bin/bash
# Nautilus script, here so it can have a keyboard shortcut (see
# ~/.config/nautilus/scripts-accels). The top-level right-click item comes
# from ~/.local/share/nautilus-python/extensions/send_to_agent.py.
mapfile -t files < <(printf '%s' "${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}" | sed '/^$/d')
[ ${#files[@]} -gt 0 ] || { notify-send -a "Send to AI agent" "Send to AI agent" "Select a file first."; exit 0; }
exec "$HOME/.local/bin/send-to-agent" "${files[@]}"
